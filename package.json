{
  "name": "excalidash-mcp",
  "version": "0.3.1",
  "description": "MCP server for controlling self-hosted ExcaliDash drawings",
  "author": "Chaehyeon Lee",
  "license": "MIT",
  "keywords": [
    "mcp",
    "excalidash",
    "excalidraw"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "excalidash-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/excalidash.js",
    "dist/excalidash.js.map",
    "dist/excalidash.d.ts",
    "dist/http.js",
    "dist/http.js.map",
    "dist/http.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.10"
  },
  "engines": {
    "node": ">=20"
  }
}
