# Docker 컨테이너에서 호스트의 ExcaliDash에 접근할 때는 localhost 대신
# host.docker.internal을 사용합니다. 외부 HTTPS 주소도 사용할 수 있습니다.
EXCALIDASH_URL=http://host.docker.internal:6767
EXCALIDASH_API_KEY=replace-with-your-api-key

# 선택 사항: MCP 시작 시 기본으로 선택할 드로잉 ID
# EXCALIDASH_DRAWING_ID=

# 선택 사항: 호스트에 공개할 loopback 포트
MCP_PORT=9003

# 선택 사항: MCP HTTP 요청 본문 최대 크기(바이트, 기본 10 MiB)
# MCP_MAX_BODY_BYTES=10485760

# 선택 사항: 동시 MCP 세션 수 상한 (기본 64)
# MCP_MAX_SESSIONS=64

# 선택 사항: 유휴 세션 정리 시간(밀리초, 기본 30분)
# MCP_SESSION_IDLE_MS=1800000
